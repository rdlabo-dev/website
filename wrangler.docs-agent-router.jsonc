{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "docs-agent-router",
  "account_id": "09b7a8355cbc8a838af7de40ed9ec7f8",
  "compatibility_date": "2026-09-19",
  "main": "./workers/docs-agent-router.ts",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "JEV_ROUTING_MODE": "enforce",
    "X402_FACILITATOR_URL": "https://api.cdp.coinbase.com/platform/v2/x402",
    "X402_NETWORK": "eip155:8453",
    "X402_PRICE": "$0.001",
  },
  "routes": [
    {
      "pattern": "docs.rdlabo.dev/projects/*",
      "zone_name": "rdlabo.dev",
    },
    {
      "pattern": "docs.rdlabo.dev/ja/projects/*",
      "zone_name": "rdlabo.dev",
    },
  ],
}
